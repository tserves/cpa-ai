{
  "name": "AccountingReport",
  "type": "object",
  "properties": {
    "session_name": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "uploaded_by": {
      "type": "string"
    },
    "file_names": {
      "type": "string",
      "description": "JSON array"
    },
    "file_urls": {
      "type": "string",
      "description": "JSON array"
    },
    "file_progress": {
      "type": "string",
      "description": "JSON array of per-file progress"
    },
    "file_metadata": {
      "type": "string",
      "description": "JSON array of per-file metadata"
    },
    "upload_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploading",
        "extracting",
        "review",
        "generating",
        "completed",
        "failed"
      ],
      "default": "uploading"
    },
    "accounting_basis": {
      "type": "string",
      "enum": [
        "cash",
        "accrual",
        "unknown"
      ],
      "default": "unknown"
    },
    "currency": {
      "type": "string",
      "default": "CAD"
    },
    "date_from": {
      "type": "string"
    },
    "date_to": {
      "type": "string"
    },
    "transactions_raw": {
      "type": "string",
      "description": "JSON array of all extracted transactions"
    },
    "transactions_reviewed": {
      "type": "string",
      "description": "JSON array of reviewed transactions"
    },
    "validation_issues": {
      "type": "string",
      "description": "JSON array of validation flags"
    },
    "bank_reconciliation": {
      "type": "string",
      "description": "JSON array of per-file reconciliation results"
    },
    "categorization_rules": {
      "type": "string",
      "description": "JSON array of saved user rules"
    },
    "total_debits": {
      "type": "number"
    },
    "total_credits": {
      "type": "number"
    },
    "transaction_count": {
      "type": "number"
    },
    "review_count": {
      "type": "number"
    },
    "auto_approved_count": {
      "type": "number"
    },
    "confidence_score": {
      "type": "number"
    },
    "gl_report": {
      "type": "string"
    },
    "pl_report": {
      "type": "string"
    },
    "trial_balance": {
      "type": "string"
    },
    "transaction_summary": {
      "type": "string",
      "description": "Monthly summary JSON"
    },
    "review_items_report": {
      "type": "string",
      "description": "Review items JSON"
    },
    "reports_generated": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "session_name"
  ]
}