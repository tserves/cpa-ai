{
  "name": "ProcessedDocument",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Reference to the Document entity"
    },
    "document_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "bank_statement",
        "receipt",
        "invoice",
        "pdf_financial",
        "csv_export",
        "other"
      ],
      "default": "other"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "needs_review"
      ],
      "default": "pending"
    },
    "extracted_data": {
      "type": "string",
      "description": "JSON string of extracted financial data"
    },
    "anomalies": {
      "type": "string",
      "description": "JSON string of flagged anomalies"
    },
    "anomaly_count": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number"
    },
    "transaction_count": {
      "type": "number"
    },
    "period_start": {
      "type": "string"
    },
    "period_end": {
      "type": "string"
    },
    "reviewer_notes": {
      "type": "string"
    },
    "reviewed": {
      "type": "boolean",
      "default": false
    },
    "mapped_to_accounting": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "document_name",
    "file_url"
  ]
}