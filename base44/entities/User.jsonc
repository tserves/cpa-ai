{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the practice",
      "enum": [
        "admin",
        "staff",
        "manager"
      ]
    },
    "job_title": {
      "type": "string",
      "description": "Job title (e.g. Senior Accountant, Tax Associate)"
    },
    "department": {
      "type": "string",
      "description": "Department or team"
    },
    "phone": {
      "type": "string",
      "description": "Office phone or mobile"
    }
  },
  "required": [
    "role"
  ]
}